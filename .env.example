# ========================================================
# Kapibala Multi-Account Group Messaging Platform
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://kapibala:kapibala@localhost:5432/kapibala?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-for-kapibala-auth-32bytes"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-for-kapibala-auth-32bytes"
ACCESS_TOKEN_EXPIRES_IN="15m"

# External Mock Services
GATEWAY_URL="http://localhost:4001"
AGENT_URL="http://localhost:4002"

# Mock Services Ports
GATEWAY_PORT=4001
AGENT_PORT=4002

# Web Console
VITE_API_URL="http://localhost:3000"
VITE_WS_URL="ws://localhost:3000/ws"
